{
  "name": "novutienda",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest",
    "test:rules": "node scripts/test-rules.mjs",
    "test:funciones": "node plataforma/funciones/scripts/probar.mjs",
    "build": "node scripts/build.mjs",
    "reglas:generar": "node scripts/reglas.mjs generar",
    "reglas:verificar": "node scripts/reglas.mjs verificar",
    "registro:generar": "node scripts/registro-panel.mjs generar",
