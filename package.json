  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "6.0.0",
    "@novutienda/nucleo": "workspace:*",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "firebase-admin": "14.5.0",
    "sharp": "0.35.5",
    "firebase": "13.2.0",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "@novutienda/inventarios": "workspace:*",
    "@novutienda/pos": "workspace:*",
    "@novutienda/recibos": "workspace:*",
    "@novutienda/website": "workspace:*",
    "@novutienda/consola": "workspace:*",
    "@novutienda/panel": "workspace:*"
  }
