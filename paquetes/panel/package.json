{
  "name": "@novutienda/panel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/sellar.mjs ../../dist/panel",
    "build:humo": "vite build --mode humo && node scripts/sellar.mjs ../../dist/panel-humo",
    "humo": "pnpm run build:humo && playwright test --config humo/playwright.config.ts",
    "build:emulador": "vite build --mode emulador && node scripts/sellar.mjs ../../dist/panel-emulador --emulador",
    "test:emulador": "node scripts/emulador.mjs \"npx vitest --run --no-file-parallelism pruebas/panel/emulador\"",
    "humo:emulador": "pnpm run build:emulador && node scripts/emulador.mjs \"SEMBRAR_E2E=1 npx vitest --run pruebas/panel/sembrar-e2e && paquetes/panel/node_modules/.bin/playwright test --config paquetes/panel/humo/playwright.emulador.config.ts\""
  },
  "dependencies": {
    "@novutienda/nucleo": "workspace:*",
    "firebase": "13.1.0",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@preact/preset-vite": "2.10.6",
    "@testing-library/dom": "10.4.2",
    "@testing-library/preact": "3.2.6",
    "@testing-library/user-event": "14.6.8",
    "jsdom": "30.1.3",
    "vite": "8.3.5"
  }
}
