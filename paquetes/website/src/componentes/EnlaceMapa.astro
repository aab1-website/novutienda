---
// Enlace destacado a Google Maps: «Visítanos» con un pin rojo, para que la tienda física se encuentre a primera vista.
interface Props { href: string }
const { href } = Astro.props;
---
<a class="enlace-mapa-destacado" href={href} target="_blank" rel="noopener noreferrer">
  <svg class="enlace-mapa-pin" width="28" height="28" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M12 1.5a8 8 0 0 0-8 8c0 5.6 6.4 11.7 7.3 12.5a1 1 0 0 0 1.4 0C13.6 21.2 20 15.1 20 9.5a8 8 0 0 0-8-8z" />
    <circle cx="12" cy="9.5" r="3" />
  </svg>
  <span class="enlace-mapa-textos">
    <strong>Visítanos</strong>
    <span>Cómo llegar en Google Maps</span>
  </span>
  <span class="solo-lectores"> (se abre en una pestaña nueva)</span>
</a>
