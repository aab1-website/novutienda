---
import Base from '../layouts/Base.astro';
import Heroe from '../componentes/Heroe.astro';
import Beneficios from '../componentes/Beneficios.astro';
import Identidad from '../componentes/Identidad.astro';
import Institucional from '../componentes/Institucional.astro';
import TarjetaProducto from '../componentes/TarjetaProducto.astro';
import CatalogoVacio from '../componentes/CatalogoVacio.astro';
import Icono from '../componentes/Icono.astro';
import CategoriasPortada from '../islas/CategoriasPortada';
import { catalogo, categoriasNavegables, contenido, enVenta } from '../contenido/instancia';
import { marcasDe } from '../contenido/consultas';
import { jsonLdOrganizacion, rutaCategoria } from '../lib/seo';
import { marcasConRuta, rutaMarca } from '../lib/paginas';
import { escribirPortada, ordenarPortada, visiblesPortada } from '../lib/portada';
import { logoParaCompartir } from '../contenido/logo-subido';
import { enlaceWhatsApp } from '../lib/whatsapp';

const { config, carruseles } = contenido;
const categorias = categoriasNavegables;
const productos = enVenta;
// La grilla trae las primeras tarjetas de «Todos» y de cada categoría; los chips muestran u ocultan, sin pedir nada.
// Orden de «Todos» y de cada categoría: destacados primero y luego el del catálogo.
const ordenados = ordenarPortada(catalogo);
const escritos = escribirPortada(ordenados);
const iniciales = visiblesPortada(ordenados, null);
// Vista previa al compartir la portada: el logo subido (PNG, JPG o WebP; nunca el de la cabecera ni un SVG) y, si no hay, la primera foto del carrusel o de un producto.
const imagenPortada = logoParaCompartir(config.imagenCompartir, config.logo) ?? carruseles[config.plantilla][0]?.url ?? productos.find((p) => p.fotos.length > 0)?.fotos[0]?.url;
const wa = enlaceWhatsApp(config.whatsappNovuchat, 'Hola, tengo una consulta.');
---
<Base titulo={config.nombre} descripcion={config.lema} ruta="/" imagen={imagenPortada} datosEstructurados={[jsonLdOrganizacion(contenido)]}>
  <Heroe />
  <Beneficios />
  <section id="productos" class="seccion categorias" aria-labelledby="titulo-categorias">
    <div class="contenedor centrado">
      <span class="etiqueta">Explora por categoría</span>
      <h2 id="titulo-categorias" class="titulo-seccion">Nuestros productos</h2>
      {productos.length === 0 ? <CatalogoVacio conBoton={false} /> : <p class="subtitulo">Elige una categoría para ver sus modelos y precios actualizados.</p>}
      {productos.length > 0 && (
        <>
          <CategoriasPortada client:load categorias={categorias.map((c) => ({ id: c.id, nombre: c.nombre, href: rutaCategoria(c.id) }))} items={ordenados.map((p) => ({ id: p.id, categoria: p.categoria }))} />
          <div id="portada-grilla" class="grilla-productos portada-grilla">
            {escritos.map((p) => <div class="portada-item" data-portada-id={p.id} hidden={!iniciales.has(p.id)}><TarjetaProducto producto={p} /></div>)}
          </div>
          <p class="portada-ver-todos"><a id="portada-ver-todos" class="boton boton-secundario" href="/productos">Ver todos los productos ({productos.length})</a></p>
        </>
      )}
      {productos.length > 0 && marcasDe(productos).length > 0 && (
        <section class="marcas" aria-labelledby="titulo-marcas">
          <h2 id="titulo-marcas">Marcas que trabajamos</h2>
          <nav aria-label="Marcas">
            <ul>{marcasConRuta(marcasDe(productos)).map((m) => <li><a href={rutaMarca(m.slug)}>{m.nombre}</a></li>)}</ul>
          </nav>
        </section>
      )}
    </div>
  </section>
  <Identidad />
  <Institucional />
  <section id="contacto" class="seccion contacto-bloque" aria-labelledby="titulo-contacto-inicio">
    <div class="contenedor contacto-interior">
      <div class="identidad-texto">
        <span class="etiqueta">Soporte y consultas</span>
        <h2 id="titulo-contacto-inicio" class="titulo-seccion">Estamos para ayudarte</h2>
        <p class="subtitulo">¿Tienes dudas sobre algún producto o quieres coordinar un envío? Escríbenos y te respondemos lo antes posible.</p>
      </div>
      <div class="tarjeta-contacto">
        {wa !== null && <a class="boton boton-cta boton-ancho" href={wa} target="_blank" rel="noopener noreferrer"><Icono nombre="mensaje" tamano={18} />ESCRIBIR POR WHATSAPP</a>}
        {config.telefono !== null && <a class="enlace-telefono" href={`tel:${config.telefono.replace(/[^+0-9]/g, '')}`}><Icono nombre="telefono" tamano={16} />Llamar al {config.telefono}</a>}
        <a class="boton boton-secundario boton-ancho" href="/contacto">ENVIAR UN MENSAJE</a>
      </div>
    </div>
  </section>
</Base>
