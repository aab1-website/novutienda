---
import Base from '../layouts/Base.astro';
---
<Base titulo="Página no encontrada" ruta="/404" noindex>
  <div class="contenedor pagina">
    <header class="encabezado-pagina">
      <h1 class="titulo-seccion">Página no encontrada</h1>
      <p class="subtitulo">La dirección que buscas no existe o fue movida.</p>
    </header>
    <p><a class="boton boton-cta" href="/">VOLVER AL INICIO</a> <a class="boton boton-secundario" href="/productos">VER PRODUCTOS</a></p>
  </div>
</Base>
