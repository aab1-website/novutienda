---
import PaginaCatalogo from '../../componentes/PaginaCatalogo.astro';
import { contenido, enVenta } from '../../contenido/instancia';
import { marcasDe } from '../../contenido/consultas';
import { marcasConRuta, rutaMarca } from '../../lib/paginas';

export function getStaticPaths() {
  return marcasConRuta(marcasDe(enVenta)).map((m) => ({ params: { marca: m.slug }, props: { nombre: m.nombre } }));
}
const { marca } = Astro.params;
const { nombre } = Astro.props;
const productos = enVenta.filter((p) => p.marca === nombre);
---
<PaginaCatalogo
  titulo={nombre}
  descripcion={`Productos de la marca ${nombre}, con precios actualizados.`}
  migas={[{ texto: 'Inicio', href: '/' }, { texto: 'Productos', href: '/productos' }]}
  productos={productos}
  base={rutaMarca(marca ?? '')}
  pagina={1}
  marcaActual={nombre}
/>
