---
import PaginaCatalogo from '../../../componentes/PaginaCatalogo.astro';
import { enVenta } from '../../../contenido/instancia';
import { paginasExtra } from '../../../lib/paginas';

export function getStaticPaths() {
  return paginasExtra(enVenta.length).map((n) => ({ params: { n: String(n) }, props: { n } }));
}
const { n } = Astro.props;
---
<PaginaCatalogo
  titulo="Catálogo de productos"
  descripcion="Todos nuestros productos con precios actualizados en tu moneda."
  subtitulo="Elige una marca. El filtro de precio actúa solo sobre los productos de la página que ves. Los precios se calculan con la cotización oficial del día."
  migas={[{ texto: 'Inicio', href: '/' }]}
  productos={enVenta}
  base="/productos"
  pagina={n}
/>
