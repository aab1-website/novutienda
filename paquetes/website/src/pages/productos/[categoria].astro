---
import PaginaCatalogo from '../../componentes/PaginaCatalogo.astro';
import { contenido } from '../../contenido/instancia';
import { productosDeCategoria } from '../../contenido/consultas';
import { rutaCategoria } from '../../lib/seo';

export function getStaticPaths() {
  return contenido.categorias.map((c) => ({ params: { categoria: c.id }, props: { categoria: c } }));
}
const { categoria } = Astro.props;
const productos = productosDeCategoria(contenido.productos, categoria.id);
---
<PaginaCatalogo
  titulo={categoria.nombre}
  descripcion={`${categoria.nombre}: modelos y precios actualizados.`}
  migas={[{ texto: 'Inicio', href: '/' }, { texto: 'Productos', href: '/productos' }]}
  productos={productos}
  base={rutaCategoria(categoria.id)}
  pagina={1}
  categoriaActual={categoria.id}
/>
